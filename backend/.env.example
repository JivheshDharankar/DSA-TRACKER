# ==============================================================================
# DSA TRACKER BACKEND — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Server Port (default: 5001)
PORT=5001

# Frontend Client Origin (Strict CORS & Cookie Domain)
# Development: http://localhost:5173
# Production: https://your-production-domain.com
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI
# Development: mongodb://localhost:27017/dsa_tracker
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dsa_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/dsa_tracker

# JWT Authentication Secret
# Must be at least 16 characters (recommended: 32+ cryptographically random characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=dsa_tracker_development_secret_key_minimum_32_chars_long

# JWT & Cookie Expiration (e.g., '7d', '24h', '30d')
JWT_EXPIRES_IN=7d

# ==============================================================================
# OPTIONAL — GEMINI AI ASSISTANCE (Phase 2B)
# ==============================================================================
# The tracker runs fully without these. When GEMINI_API_KEY is absent, the AI panel
# explains that assistance is not configured and every other feature is unaffected.
#
# Create a key in Google AI Studio. Keep it server-side: it is never sent to the browser.
# GEMINI_API_KEY=your-google-ai-studio-key
#
# Flash-class model id. Configurable so a model change needs no code change.
# GEMINI_MODEL=gemini-3.8-flash
#
# Provider timeout and output cap (milliseconds / tokens).
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_OUTPUT_TOKENS=2400
#
# Application-level safeguards. These are NOT Google quota numbers.
# AI_USER_RATE_LIMIT_WINDOW_MS=600000
# AI_USER_RATE_LIMIT_MAX=20
# AI_GLOBAL_RATE_LIMIT_WINDOW_MS=600000
# AI_GLOBAL_RATE_LIMIT_MAX=150
#
# In-process response cache.
# AI_CACHE_TTL_MS=21600000
# AI_CACHE_MAX_ENTRIES=500

# Optional — Gemini AI Assistance (Phase 2B)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash
